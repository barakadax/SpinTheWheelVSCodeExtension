{
  "name": "barakadax-spin-the-wheel",
  "displayName": "Spin the wheel",
  "description": "A VSCode extension that provides a spin the wheel in the activity bar.",
  "version": "1.0.0",
  "license": "AGPL-3.0",
  "publisher": "Barakadax",
  "icon": "icon_128.png",
  "repository": "https://github.com/barakadax/SpinTheWheelVSCodeExtension",
  "author": { "name": "Barak Taya" },
  "homepage": "https://barakadax.github.io/",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Visualization",
    "Testing",
    "Debuggers",
    "Education",
    "Other"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**",
    "src/**",
    "LICENSE",
    "icon.png",
    "icon_128.png"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spin-the-wheel-container",
          "title": "Spin the Wheel",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "spin-the-wheel-container": [
        {
          "type": "webview",
          "icon": "icon.png",
          "id": "spinTheWheelViewer",
          "name": ""
        }
      ]
    },
    "configuration": {
      "title": "Spin the Wheel",
      "properties": {
        "spinTheWheel.enableConfetti": {
          "type": "boolean",
          "default": true,
          "description": "Show a big winning screen with confetti in the center of the editor when an option is selected."
        },
        "spinTheWheel.confettiScreenCloseTimeout": {
          "type": [
            "integer",
            "null"
          ],
          "default": null,
          "markdownDescription": "Timeout in seconds before the confetti celebration window is closed automatically. If set to `null`, `0`, or not defined, the window will remain open."
        },
        "spinTheWheel.targetAI": {
          "type": "string",
          "default": "copilot",
          "enum": [
            "copilot",
            "cline",
            "claude",
            "all",
            "no"
          ],
          "enumDescriptions": [
            "GitHub Copilot Chat",
            "Cline (Claude Dev) Chat",
            "Claude Chat",
            "Send to all available AI assistants",
            "Do not send to any AI assistant"
          ],
          "description": "Select which AI chat assistant to send the spin results to."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@types/vscode": "^1.108.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.5"
  }
}
