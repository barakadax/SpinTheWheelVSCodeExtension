{
  "name": "barakadax-spin-the-wheel",
  "displayName": "Spin the wheel",
  "description": "A VSCode extension that provides a spin the wheel in the activity bar.",
  "version": "0.0.5",
  "license": "AGPL-3.0",
  "publisher": "Barakadax",
  "icon": "icon_128.png",
  "repository": "https://github.com/barakadax/SpinTheWheelVSCodeExtension",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Visualization",
    "Testing",
    "Debuggers",
    "Education",
    "Other"
  ],
  "main": "./out/extension.js",
  "files": [
    "out/**",
    "src/**",
    "LICENSE",
    "icon.png",
    "icon_128.png"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spin-the-wheel-container",
          "title": "Spin the Wheel",
          "icon": "icon.png"
        }
      ]
    },
    "views": {
      "spin-the-wheel-container": [
        {
          "type": "webview",
          "icon": "icon.png",
          "id": "spinTheWheelViewer",
          "name": ""
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "25.x",
    "@types/vscode": "^1.120.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^10.4.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.5"
  }
}
